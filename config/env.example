# Kopieras till ~/.hermes/.env (rättigheter 600) av install/02-wsl.sh.
# Committa ALDRIG den riktiga .env-filen.

# Telegram: skapa en bot hos @BotFather och klistra in token här.
TELEGRAM_BOT_TOKEN=

# Ditt numeriska Telegram-ID (fråga @userinfobot). Bara det här ID:t får prata med kollegan.
TELEGRAM_ALLOWED_USERS=

# Släpp aldrig in alla. Ska vara false eller saknas.
GATEWAY_ALLOW_ALL_USERS=false

# Valfritt: API-nyckel för tyngre jobb (kostar pengar per anrop).
# OPENROUTER_API_KEY=

# Larm till mobilen via ntfy. Ämnet är hemligt: alla som vet det kan läsa larmen.
# install/02-wsl.sh fyller i ett slumpat ämne.
NTFY_TOPIC=
